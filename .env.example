# Backend (.env, loaded by src/api.py). Copy to .env and fill in.

# Required to call /classify or /report. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required in production. Shared password the frontend forwards on every
# request; the backend refuses to serve /classify or /report without it.
APP_PASSWORD=

# Set to 1 to run the backend locally without APP_PASSWORD configured.
# Do not set this in production.
ALLOW_NO_PASSWORD=

# Comma-separated origins allowed to call the API. Defaults to
# http://localhost:3000 if unset.
# FRONTEND_ORIGIN=http://localhost:3000

# Spend and abuse controls — defaults shown, uncomment to override.
# RATE_LIMIT_PER_HOUR=30
# DAILY_CLASSIFY_CAP=200
# MAX_AUTH_FAILURES=10
# AUTH_LOCKOUT_SECONDS=900
